# Backend Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL Sandbox Configuration (Sandbox User)
# SECURITY: These credentials are used by the application to execute student queries
# with limited (SELECT-only) privileges.
PG_HOST=localhost
PG_PORT=5432
PG_USER=sandbox_reader
PG_PASSWORD=8427tanuK@
PG_DATABASE=CipherSQLStdio_DB

# MongoDB Configuration
# Used for assignment metadata and optional user progress tracking
# Local dev: mongodb://localhost:27017/ciphersql
# Docker: mongodb://mongo:27017/ciphersql
MONGO_URI=mongodb://localhost:27017/ciphersql

# LLM Hint Generation Service
# Currently supports: openai
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here

# Execution Limits & Query Sandbox Security
# Ensures sandbox safety and resource management
QUERY_STATEMENT_TIMEOUT_MS=2000
QUERY_LOCK_TIMEOUT_MS=2000
QUERY_ROW_LIMIT=500

# Frontend Configuration (Vite)
# Only needed if running the frontend in specific environments or production
VITE_API_URL=http://localhost:4000

